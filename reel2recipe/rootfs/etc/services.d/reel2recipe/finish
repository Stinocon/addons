#!/command/with-contenv bashio
# If the interface dies, the add-on has no reason left to stay up: without it there would only
# be a silent Ollama taking up memory. Better to stop and let that show in the add-on's state
# than to stay "running" while serving nothing.
bashio::log.warning "The interface stopped (code ${1}). Halting the add-on."
exec /run/s6/basedir/bin/halt
