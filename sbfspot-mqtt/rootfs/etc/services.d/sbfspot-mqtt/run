#!/command/with-contenv bashio
# shellcheck shell=bash
# The add-on's whole job: point the program at its two files and let it run.
#
# The options are read from /data/options.json and handed on as a path. `bashio::config` is not
# used for them because it does not read that file -- it asks the Supervisor API -- so a check
# written with it fails whenever the API is unreachable and blames the wrong thing. The Supervisor
# has already validated the options from the file, with messages that name the field.
#
# What is genuinely only in the API is the MQTT *service*, and that is the one thing resolved here:
# the program has no idea a Supervisor exists, which is what lets it run anywhere else too.
set -e

readonly OPTIONS=/data/options.json
readonly MQTT=/data/mqtt.json
readonly APP=/usr/bin/sbfspot-mqtt
readonly SBFSPOT=/usr/bin/sbfspot/SBFspot

# One topic for the state, whatever the plant is called, so the discovery payloads can be written
# before the inverter has ever answered. More than one inverter on the same Bluetooth network is
# not supported by this version, and a topic per serial would only pretend otherwise.
readonly STATE_TOPIC=sbfspot_mqtt/state
readonly AVAILABILITY_TOPIC=sbfspot_mqtt/availability

# The broker: the Supervisor's, unless the options name another one.
mqtt_host="$(jq -r '.mqtt_host // ""' "${OPTIONS}")"
mqtt_port="$(jq -r '.mqtt_port // 1883' "${OPTIONS}")"
mqtt_username="$(jq -r '.mqtt_username // ""' "${OPTIONS}")"
mqtt_password="$(jq -r '.mqtt_password // ""' "${OPTIONS}")"

if [[ -z "${mqtt_host}" ]]; then
    if ! bashio::services.available "mqtt"; then
        bashio::log.error "No MQTT broker is available. Install and start the Mosquitto add-on, or"
        bashio::log.error "set mqtt_host, mqtt_port and the credentials in this add-on's"
        bashio::log.error "configuration to point at a broker elsewhere."
        exit 1
    fi
    mqtt_host="$(bashio::services "mqtt" "host")"
    mqtt_port="$(bashio::services "mqtt" "port")"
    mqtt_username="$(bashio::services "mqtt" "username")"
    mqtt_password="$(bashio::services "mqtt" "password")"
fi

# It arrives as a string from either source and would be written into JSON as a number: an empty
# or non-numeric value would fail the start over punctuation.
if ! [[ "${mqtt_port}" =~ ^[0-9]+$ ]]; then
    bashio::log.warning "Broker port '${mqtt_port}' is not a number; using 1883."
    mqtt_port=1883
fi

# Written to /data, mode 600, and excluded from backups: a password on its way to mosquitto_pub is
# not configuration worth restoring. The program reads it, so no credential passes through here.
jq -n \
    --arg host "${mqtt_host}" \
    --argjson port "${mqtt_port}" \
    --arg username "${mqtt_username}" \
    --arg password "${mqtt_password}" \
    --arg topic "${STATE_TOPIC}" \
    --arg availability_topic "${AVAILABILITY_TOPIC}" \
    --arg discovery_prefix "homeassistant" \
    '{host: $host, port: $port, username: $username, password: $password,
      topic: $topic, availability_topic: $availability_topic, discovery_prefix: $discovery_prefix}' \
    > "${MQTT}"
chmod 600 "${MQTT}"

bashio::log.info "sbfspot-mqtt $("${APP}" version), SBFspot $("${SBFSPOT}" -version 2> /dev/null || true)"

# exec, so s6 supervises the program itself and SIGTERM reaches it directly. The program logs the
# inverter and the broker it was given; this script does not repeat them.
exec "${APP}" watch --options "${OPTIONS}" --mqtt "${MQTT}" --sbfspot "${SBFSPOT}"
