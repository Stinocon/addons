#!/command/with-contenv bashio
# The bridge: one MPEG-TS proxy per configured camera, supervised.
#
# There is deliberately almost nothing here. Login, token expiry, restarts and backoff all live
# in the Python supervisor, because they are one problem — "keep a working session and a live
# proxy" — and splitting it across a shell script and a program is how the two halves end up
# disagreeing about whose turn it is to log in.
#
# The options are not unpacked into arguments either: the password would land in the process
# table. The supervisor reads /data/options.json itself.
#
# And no `bashio::config` validation of those options, which is the non-obvious part. bashio
# does not read /data/options.json — it asks the Supervisor API. So a guard written with it
# fails whenever that API is unreachable, and reports the wrong cause: an early version of this
# script announced "set the username and password" on a run where both were set correctly, and
# the real fault was a DNS lookup for `supervisor`. The supervisor validates the same options
# from the file directly, with messages that name the actual field, so validating here would be
# a second, less reliable copy of a check that already exists.

set -e

bashio::log.info "Starting EZVIZ Stream Bridge…"

# exec, so s6 supervises the supervisor itself and SIGTERM reaches it directly: it needs the
# signal to shut its proxies down, and a shell in between would swallow it.
exec ezviz-stream-bridge \
    --options /data/options.json \
    --token-file /data/ezviz_token.json
