#!/command/with-contenv bashio
# Ollama, the local model that structures the recipe.
#
# It listens on 127.0.0.1 only: it is a service internal to the add-on, not a network
# endpoint. The project's founding constraint is that no data leaves the machine, and an
# exposed Ollama would be an elegant way of breaking it by accident.

bashio::log.info "Starting Ollama (models in ${OLLAMA_MODELS})…"

exec /usr/local/bin/ollama serve
