#!/command/with-contenv bashio
# Reel2Recipe's web interface, served to Home Assistant through the Ingress.
#
# The order of things: wait for Ollama to answer, start the model download if it is missing,
# and start anyway. The download deliberately does not block start-up — it is several GB and
# can take tens of minutes — because the interface already has an honest way of saying that
# the brain is not ready: `/api/status`, which the page polls by itself.

set -e

MODEL="$(bashio::config 'modello_llm')"
[[ "${MODEL}" == *:* ]] || MODEL="${MODEL}:latest"   # the way Ollama registers it

# The cookie file is for the reels that require being logged in. There is no browser in here
# to pull them from, so the way is a file exported elsewhere and dropped into /share.
if bashio::config.has_value 'file_cookie'; then
    # The path is relative to /share, but writing it out in full is the mistake everybody
    # makes the first time: it is tolerated instead of producing "/share//share/cookies.txt"
    # and a file-not-found that explains nothing.
    cookie="$(bashio::config 'file_cookie')"
    cookie="${cookie#/}"
    cookie="${cookie#share/}"
    export R2R_COOKIES="/share/${cookie}"
    bashio::log.info "Cookies from ${R2R_COOKIES} (a copy is used: the original is left alone)."
fi

# ---------------------------------------------------------------------------------------
# Waiting for Ollama
# ---------------------------------------------------------------------------------------
bashio::log.info "Waiting for Ollama to answer…"
for _ in $(seq 1 60); do
    if curl -sf --max-time 2 "http://127.0.0.1:11434/api/tags" > /dev/null 2>&1; then
        break
    fi
    sleep 1
done

if ! curl -sf --max-time 2 "http://127.0.0.1:11434/api/tags" > /dev/null 2>&1; then
    bashio::log.warning "Ollama has not answered in 60 s: the interface starts anyway and will report «LLM not ready»."
fi

# ---------------------------------------------------------------------------------------
# The model, in the background
# ---------------------------------------------------------------------------------------
# A single attempt: it starts the pull, beats once a minute and reports how it went.
one_attempt() {
    # The output of `ollama pull` is a progress bar made of carriage returns: poured into the
    # add-on log it would make it unreadable. Better one heartbeat a minute with how much is
    # already on disk — it says the same thing in twenty lines instead of twenty thousand.
    ollama pull "${MODEL}" > /tmp/pull.log 2>&1 &
    local pid=$!
    while kill -0 "${pid}" 2> /dev/null; do
        sleep 60
        bashio::log.info "…download under way: $(du -sh "${OLLAMA_MODELS}" 2> /dev/null | cut -f1) on disk."
    done
    wait "${pid}"
}

# Nine gigabytes failing once is not an exceptional case: it is the statistical norm. A
# `digest mismatch` at the end of the download — seen for real, on the first install — left
# the add-on brainless for good, because the pull was attempted exactly once. Hence the
# repeated attempts.
#
# But there are THREE of them, not infinitely many: if the cause is a full disk, retrying
# forever does not fix it, it fills the log and keeps the machine busy. After three rounds it
# stops and says what to do.
ATTEMPTS=3

download_in_background() {
    bashio::log.info "Downloading ${MODEL}. It is several GB: the interface is already open and stays «not ready» until it finishes."

    local wait_seconds=30
    for attempt in $(seq 1 "${ATTEMPTS}"); do
        if one_attempt; then
            bashio::log.info "Model ${MODEL} ready: recipes can be extracted from now on."
            return 0
        fi

        # The free space goes into the log on every failure, because it is the question you
        # ask straight afterwards and it tells the two causes apart: a file truncated by a
        # full disk gives the same `digest mismatch` as corruption in transit.
        bashio::log.warning \
            "Attempt ${attempt} of ${ATTEMPTS} failed: $(tail -n 3 /tmp/pull.log)"
        bashio::log.warning \
            "Free space on /data: $(df -h /data 2> /dev/null | awk 'NR==2 {print $4}')."

        if [ "${attempt}" -lt "${ATTEMPTS}" ]; then
            bashio::log.info "Retrying in ${wait_seconds} s."
            sleep "${wait_seconds}"
            wait_seconds=$((wait_seconds * 2))
        fi
    done

    bashio::log.error \
        "Downloading ${MODEL} failed ${ATTEMPTS} times. If the free space above is less than the size of the model, the problem is the disk; otherwise restart the add-on to try again."
    return 1
}

if bashio::config.true 'scarica_modello'; then
    if ollama list 2> /dev/null | awk '{print $1}' | grep -Fxq "${MODEL}"; then
        bashio::log.info "Model ${MODEL} already present."
    else
        download_in_background &
    fi
else
    bashio::log.info "Automatic download is off: with no model in /data/ollama, nothing gets extracted."
fi

# ---------------------------------------------------------------------------------------
# The transcription model, brought forward as well
# ---------------------------------------------------------------------------------------
# faster-whisper downloads its model (~1.5 GB) on the FIRST transcription, that is inside the
# user's request and without telling anybody: the bar would sit on «Transcribing the speech»
# for minutes with nothing in the log explaining why. Better to pay for it at start-up, when
# a download is already under way and nobody is waiting for a recipe.
warm_whisper() {
    bashio::log.info "Preparing the transcription model (~1.5 GB)…"
    if /app/.venv/bin/python -c \
        "from faster_whisper import WhisperModel; WhisperModel('large-v3-turbo', device='cpu', compute_type='int8')" \
        > /tmp/whisper.log 2>&1; then
        bashio::log.info "Transcription model ready."
    else
        bashio::log.warning "Preparing transcription failed: $(tail -n 2 /tmp/whisper.log). It will be retried on the first reel."
    fi
}

if [ -z "$(ls -A "${HF_HOME}/hub" 2> /dev/null)" ]; then
    warm_whisper &
fi

# ---------------------------------------------------------------------------------------
# The interface
# ---------------------------------------------------------------------------------------
# 0.0.0.0 and not 127.0.0.1: what connects is Home Assistant's Ingress, from outside the
# container. The port is not exposed outwards unless it is explicitly mapped.
#
# The virtual environment's binary is run directly instead of `uv run`: the only environment
# that exists here is the one uv built at build time, and one layer fewer means s6 supervises
# the real process and the signals arrive where they should.
# «Starting» and not «ready»: the message comes before the exec, so it cannot testify that the
# server came up. When it said «ready» the log asserted something untrue for four restarts in
# a row, and sent the diagnosis down the wrong path.
bashio::log.info "Starting the interface on port 8500 (Ingress)…"

# --ollama BEFORE `serve`: it is a global option of the program, not of the subcommand, and
# argparse rejects it after the subcommand. Put after, the interface exited with code 2 on
# every start, s6 restarted forever and the Ingress found nobody listening: Home Assistant
# answered «502 Bad Gateway». The contract is pinned by `tests/test_cli.py` in the Reel2Recipe
# repo: if this line is touched, that one gets updated.
exec /app/.venv/bin/r2r \
    --ollama "http://127.0.0.1:11434" \
    serve \
    --host 0.0.0.0 \
    --port 8500
